#!/usr/bin/env bash

set -euo pipefail

plugin_dir=$(dirname "$(dirname "${BASH_SOURCE[0]}")")
# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

# $1 is an optional prefix filter, e.g. `0.1`. Prereleases are excluded so
# `latest` never resolves to an rc, which matters because release-please can
# put the CLI on a prerelease line without this plugin changing.
query="${1:-}"

versions=$(list_all_versions | grep -v -- '-' | sort_versions)
if [ -n "$query" ]; then
	versions=$(printf '%s\n' "$versions" | grep -E "^${query}" || true)
fi

printf '%s\n' "$versions" | tail -1
